# Copy to .env.local and fill in. Use the same Supabase project as the web app
# (its NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY values).
# Also add both variables to the Vercel project for staffconnect-mobile.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
